{
  "name": "@decentdocs/tailwind",
  "version": "1.1.1",
  "description": "The Tailwind CSS utils for Decent Docs UI.",
  "keywords": [
    "Docs",
    "decent-docs"
  ],
  "homepage": "https://github.com/kitretsusaisama/decent-docs#readme",
  "bugs": {
    "url": "https://github.com/kitretsusaisama/decent-docs/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kitretsusaisama/decent-docs.git",
    "directory": "packages/tailwind"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./typography": "./dist/typography/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@fastify/deepmerge": "^3.2.1",
    "@types/node": "^26.6.4",
    "postcss-selector-parser": "^7.1.6",
    "tailwindcss": "^4.3.3",
    "tsconfig": "workspace:*",
    "tsdown": "0.23.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "inlinedDependencies": {
    "@fastify/deepmerge": "3.2.1",
    "cssesc": "3.0.0",
    "postcss-selector-parser": "7.1.6",
    "util-deprecate": "1.0.2"
  }
}
