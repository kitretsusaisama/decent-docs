{
  "name": "@decentdocs/local-content",
  "version": "1.1.1",
  "description": "Shared building blocks for local content sources in Decent Docs",
  "keywords": [
    "Docs",
    "decent-docs"
  ],
  "homepage": "https://github.com/kitretsusaisama/decent-docs#readme",
  "bugs": {
    "url": "https://github.com/kitretsusaisama/decent-docs/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kitretsusaisama/decent-docs.git",
    "directory": "packages/local-content"
  },
  "bin": {
    "decent-local-md": "./bin.js"
  },
  "files": [
    "dist",
    "bin.js"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./dev/vite": "./dist/dev/vite/index.js",
    "./dev/ws": "./dist/dev/ws/index.js",
    "./dev/ws/bin": "./dist/dev/ws/bin.js",
    "./dev/ws/react": "./dist/dev/ws/react.js",
    "./dev/ws/server": "./dist/dev/ws/server.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "test": "vitest run",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "picomatch": "^4.0.7",
    "tinyglobby": "^0.2.17",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@decentdocs/core": "workspace:*",
    "@types/node": "26.6.4",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "react": "^19.3.0",
    "tsconfig": "workspace:*",
    "tsdown": "0.23.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@decentdocs/core": "workspace:^",
    "@types/react": "*",
    "react": "^19.2.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
