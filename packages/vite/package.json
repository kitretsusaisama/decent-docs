{
  "name": "@decentdocs/vite",
  "version": "1.0.0",
  "private": true,
  "description": "Internal configs for Decent Docs + Vite",
  "keywords": [
    "Docs",
    "decent-docs",
    "vite"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch --clean false",
    "lint": "oxlint .",
    "test": "vitest run",
    "types:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsconfig": "workspace:*",
    "tsdown": "0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
