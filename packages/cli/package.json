{
  "name": "@decentdocs/cli",
  "version": "1.1.1",
  "description": "The CLI tool for Decent Docs",
  "keywords": [
    "Docs",
    "decent-docs"
  ],
  "homepage": "https://github.com/kitretsusaisama/decent-docs#readme",
  "bugs": {
    "url": "https://github.com/kitretsusaisama/decent-docs/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitretsusaisama/decent-docs.git",
    "directory": "packages/cli"
  },
  "bin": {
    "decent-docs": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./codemod": "./dist/codemod/index.js",
    "./config": "./dist/config.js",
    "./features": "./dist/features/index.js",
    "./features/all": "./dist/features/all.js",
    "./features/docs": "./dist/features/docs/index.js",
    "./features/lint": "./dist/features/lint.js",
    "./features/llms": "./dist/features/llms.js",
    "./features/mcp": "./dist/features/mcp.js",
    "./features/og": "./dist/features/og.js",
    "./features/search": "./dist/features/search.js",
    "./features/utils": "./dist/features/utils.js",
    "./features/webmcp": "./dist/features/webmcp.js",
    "./project": "./dist/project/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "cac": "^7.0.0",
    "fuma-cli": "^0.3.1",
    "magic-string": "^1.4.2",
    "oxc-parser": "^0.152.0",
    "picocolors": "^1.1.1",
    "tinyexec": "^1.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "tsconfig": "workspace:*",
    "tsdown": "0.23.0"
  },
  "engines": {
    "node": ">=20"
  }
}
