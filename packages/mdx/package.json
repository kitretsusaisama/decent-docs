    "estree-util-value-to-estree": "^3.5.0",
    "github-slugger": "^2.0.0",
    "magic-string": "^1.4.2",
    "mdast-util-mdx": "^3.0.0",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "tinyexec": "^1.3.1",
    "tinyglobby": "^0.2.17",
    "unified": "^11.0.5",
    "unist-util-remove-position": "^5.0.0",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "yaml": "^2.9.1",
    "yuku-analyzer": "^0.17.0",
