    "@decentdocs/core": "workspace:*",
    "@decentdocs/satteri": "workspace:*",
    "@decentdocs/vite": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "mdast-util-directive": "^3.1.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "remark": "^15.0.1",
    "remark-directive": "^4.0.0",
    "remark-mdx": "^3.1.1",
    "rolldown": "^1.2.12",
    "satteri": "^0.10.5",
    "tsconfig": "workspace:*",
    "tsdown": "0.23.0",
    "vite": "^8.3.2",
    "webpack": "^5.111.1"
  },
  "peerDependencies": {
    "@decentdocs/core": "workspace:^",
    "@decentdocs/satteri": "workspace:^",
    "@types/mdast": "*",
    "@types/mdx": "*",
    "@types/react": "*",
    "mdast-util-directive": "*",
    "next": "^15.3.0 || ^16.0.0",
    "react": "^19.2.0",
    "rolldown": "*",
    "satteri": "^0.10.5",
    "vite": "7.x.x || 8.x.x"
  },
  "peerDependenciesMeta": {
    "@decentdocs/satteri": {
      "optional": true
    },
    "satteri": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "mdast-util-directive": {
      "optional": true
    },
    "@types/mdast": {
      "optional": true
    },
    "@types/mdx": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
