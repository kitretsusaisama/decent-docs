{
  "name": "@decentdocs/docgen",
  "version": "1.1.1",
  "description": "Useful remark utilities and plugins",
  "keywords": [
    "Docs",
    "decent-docs",
    "mdx",
    "remark"
  ],
  "homepage": "https://github.com/kitretsusaisama/decent-docs#readme",
  "bugs": {
    "url": "https://github.com/kitretsusaisama/decent-docs/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kitretsusaisama/decent-docs.git",
    "directory": "packages/doc-gen"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./remark-ts2js": {
      "types": "./dist/remark-ts2js.d.ts",
      "import": "./dist/remark-ts2js.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "estree-util-to-js": "^2.0.0",
    "estree-util-value-to-estree": "^3.5.0",
    "npm-to-yarn": "^3.2.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "yuku-codegen": "^0.17.0",
    "yuku-parser": "^0.17.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@decentdocs/core": "workspace:*",
    "@mdx-js/mdx": "^3.1.1",
    "@types/estree": "^1.0.9",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "26.6.4",
    "mdast-util-mdx": "^3.0.0",
    "remark": "^15.0.1",
    "tsconfig": "workspace:*",
    "tsdown": "0.23.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@decentdocs/core": "workspace:^",
    "@types/estree": "*",
    "@types/hast": "*",
    "@types/mdast": "*",
    "mdast-util-mdx": "*"
  },
  "peerDependenciesMeta": {
    "mdast-util-mdx": {
      "optional": true
    },
    "@types/hast": {
      "optional": true
    },
    "@types/mdast": {
      "optional": true
    },
    "@types/estree": {
      "optional": true
    }
  }
}
