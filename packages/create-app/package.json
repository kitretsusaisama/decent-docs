{
  "name": "create-decent-docs",
  "version": "1.1.1",
  "description": "Create a new documentation site with Decent Docs",
  "keywords": [
    "Docs",
    "decent-docs",
    "react"
  ],
  "homepage": "https://github.com/kitretsusaisama/decent-docs#readme",
  "bugs": {
    "url": "https://github.com/kitretsusaisama/decent-docs/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kitretsusaisama/decent-docs.git",
    "directory": "packages/create-app"
  },
  "bin": "./dist/bin.js",
  "files": [
    "dist",
    "template"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins/*": {
      "types": "./dist/plugins/*.d.ts",
      "import": "./dist/plugins/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run sync && tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit",
    "sync": "node ./scripts/sync.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@decentdocs/cli": "workspace:*",
    "cac": "^7.0.0",
    "picocolors": "^1.1.1",
    "tinyexec": "^1.3.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "26.6.4",
    "tinyglobby": "^0.2.17",
    "tsconfig": "workspace:*",
    "tsdown": "0.23.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
