{
  "name": "@decentdocs/content",
  "version": "1.1.1",
  "description": "Content collections for Decent Docs",
  "keywords": [
    "Docs",
    "decent-docs"
  ],
  "homepage": "https://github.com/kitretsusaisama/decent-docs#readme",
  "bugs": {
    "url": "https://github.com/kitretsusaisama/decent-docs/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kitretsusaisama/decent-docs.git",
    "directory": "packages/content"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./runtime": "./dist/runtime.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@decentdocs/core": "workspace:*",
    "@types/node": "^26.6.4",
    "fuma-content": "^1.4.0",
    "react-dom": "^19.3.0",
    "tsconfig": "workspace:*",
    "tsdown": "0.23.0"
  },
  "peerDependencies": {
    "@decentdocs/core": "workspace:^",
    "fuma-content": "^1.2.3"
  }
}
