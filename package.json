{
  "name": "root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "build:examples": "turbo run build --filter=./examples/*",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "dev:docs": "turbo run dev --filter=docs",
    "dev:packages": "turbo run dev --filter=./packages/*",
    "dev:examples": "turbo run dev --filter=./examples/*",
    "example": "node scripts/run-example.mjs",
    "preview": "turbo run build --filter=docs && pnpm --filter docs start",
    "lint": "turbo run lint",
    "lint:format": "oxfmt --check",
    "lint:fix": "oxfmt && oxlint . --fix",
    "format": "oxfmt",
    "release": "changeset publish",
    "version-packages": "changeset version",
    "check:publish": "node scripts/check-publish.mjs",
    "check:pack": "node scripts/check-publish.mjs --pack",
    "check:changeset": "changeset status",
    "changeset": "changeset",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "types:check": "turbo run types:check --continue",
    "verify": "pnpm build:packages && pnpm types:check && pnpm test:run && pnpm lint && pnpm lint:format && pnpm check:pack"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "publint": "^0.3.25",
    "rimraf": "^6.1.3",
    "tinyexec": "^1.3.1",
    "turbo": "2.11.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">= 24.14.0"
  },
  "packageManager": "pnpm@12.8.1"
}
